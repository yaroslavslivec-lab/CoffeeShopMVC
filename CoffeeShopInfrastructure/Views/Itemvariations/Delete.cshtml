@model CoffeeShopDomain.Model.Itemvariation

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Item Variation</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Menu Item</dt>
        <dd class="col-sm-10">@Model.MenuItem?.ItemName</dd>
        <dt class="col-sm-2">Size</dt>
        <dd class="col-sm-10">@Model.Size?.SizeName</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Price)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>