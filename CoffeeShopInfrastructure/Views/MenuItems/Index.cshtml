@model IEnumerable<CoffeeShopDomain.Model.Menuitem>

@{
    ViewData["Title"] = "Menu Items";
}

<h1>Menu Items</h1>

<p>
    <a asp-action="Create" asp-route-categoryId="@ViewBag.CategoryId">Create New</a>
    <a asp-controller="Categories" asp-action="Index">Back to Categories</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ItemName)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ItemName)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@item.Category?.CategoryName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>